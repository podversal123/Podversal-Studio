# Backend API base URL (must end with /api)
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Server-only (no NEXT_PUBLIC_ prefix): real backend origin that /api/auth/google*
# gets proxied to (see next.config.js rewrites), so Google's consent screen shows
# this site's own domain instead of the Render backend's onrender.com URL.
# Local dev: http://localhost:3001
# Production (Vercel): https://podversal-backend.onrender.com
BACKEND_ORIGIN=http://localhost:3001

# Cloudinary  for gallery/video/blog image uploads (unsigned upload preset)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=podversal_uploads
